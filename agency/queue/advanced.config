%% queue — RabbitMQ 4: the TLS options of the 5671 listener. TLS 1.2 only, the
%% certificate issued by the internal CA, and the two curves the listener offers.
[
 {rabbit, [
   {ssl_options, [
     {cacertfile, "/etc/rmq-tls/ca.crt"},
     {certfile,   "/etc/rmq-tls/queue.crt"},
     {keyfile,    "/etc/rmq-tls/queue.key"},
     {verify, verify_none},
     {fail_if_no_peer_cert, false},
     {versions, ['tlsv1.2']},
     {eccs, [secp256r1, secp384r1]},
     {honor_ecc_order, true}
   ]}
 ]}
].
