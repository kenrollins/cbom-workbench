# The central crypto policy's key exchange for this listener, rendered by rule, approved and
# applied by the runner; mounted from agency/generated/bastion/. First, because OpenSSH uses the
# first value it reads for a setting: a line here takes precedence over the same one below.
Include /etc/ssh/policy/kex.conf
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key
KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512,curve25519-sha256
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
Subsystem sftp internal-sftp
