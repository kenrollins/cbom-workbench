# kit/engines.sh reads kit/engines.env (copy this file). Images are the deployment's choice; the
# application knows only the tiers in kit/inference.yaml. Shares are of the box's unified memory
# and must sum, with the harness and the estate, to less than one.
NGC_ENV_FILE=$HOME/.config/nim/ngc.env            # NGC_API_KEY=... (mode 600); NIMs need it to fetch weights
# The fast tier: `vllm` serves FAST_MODEL from the HF cache with a reasoning parser (thinking separated
# from the typed reply); `nim` runs FAST_IMAGE. On the lab GB10, Lightning 30B-A3B under vLLM with
# thinking on reached the floors of call-site read and classification (spike S3 round 1); the Nano 9B
# NIM reached none (2026-11-04).
FAST_ENGINE=vllm
FAST_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
# Only with FAST_ENGINE=nim, and only by digest: engines.sh refuses a tag. The digest is not filled in
# here because it was not read from NGC when this file was written; pull the image once and take it from
# docker inspect --format '{{index .RepoDigests 0}}' nvcr.io/nim/nvidia/nvidia-nemotron-nano-9b-v2-dgx-spark:latest
FAST_IMAGE=nvcr.io/nim/nvidia/nvidia-nemotron-nano-9b-v2-dgx-spark@sha256:DIGEST-OF-THE-PULLED-IMAGE
FAST_SHARE=0.20
FAST_WINDOW=40960
DELIBERATE_IMAGE=vllm/vllm-openai@sha256:cb9bc64f0f038c2c2ebf13b31248fb87aca40c356c3d20f363be087cfcff1fcd
DELIBERATE_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
DELIBERATE_SHARE=0.55
DELIBERATE_WINDOW=131072
HF_CACHE=$HOME/.cache/huggingface                  # where the models' weights are, or will be fetched to
VLLM_CACHE=$HOME/.cache/pqch-vllm                  # torch.compile artefacts, so a restart does not recompile
# The embed tier runs on ollama (open source): the retrieval NIM's only GB10-compatible profile is ONNX
# fp16 and it fails at inference on this board (journal, 2026-11-04). The model is pulled once into a volume.
EMBED_IMAGE=ollama/ollama@sha256:075246f72d4109385b4a01c3ac8e9cbd26a0bcb21cd7aa30edbccd24e1b3180c
EMBED_MODEL=mxbai-embed-large
