# Copy to .env (git-ignored) and fill in. Read by `docker compose`.
PQCH_UID=1000
PQCH_GID=1000
# The group that owns /var/run/docker.sock on this host: `getent group docker`.
DOCKER_GID=999
# Labels every timing this deployment produces.
PQCH_HARDWARE=unlabelled
# Absolute path of this repository's agency/ directory. The runner hands it to
# Compose when it applies a change, so it must be the path on the host.
PQCH_AGENCY_DIR=/absolute/path/to/cbom-workbench/agency
